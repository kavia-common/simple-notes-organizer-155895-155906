# Environment variables for notes_frontend (Qwik + Vite)
# Copy this file to ".env" and set values as needed.

# Base URL for the backend API serving /notes and /categories endpoints.
# Examples:
#   VITE_API_BASE_URL=https://api.example.com
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=/api

# Alternative public env variable name (also supported by the app)
# PUBLIC_API_BASE_URL=/api
